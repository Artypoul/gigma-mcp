  "initialize": {
    "result": {
      "protocolVersion": "2025-06-18",
      "serverInfo": {
        "name": "Gigma Auth: MCP Owner",
        "version": "1.30.0"
      },
      "capabilities": {
        "tools": {
          "listChanged": false
        },
        "resources": {
          "subscribe": false,
          "listChanged": false
        }
      }
    }
